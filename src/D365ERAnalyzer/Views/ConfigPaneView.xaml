<UserControl x:Class="D365ERAnalyzer.Views.ConfigPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:D365ERAnalyzer.Converters"
             xmlns:views="clr-namespace:D365ERAnalyzer.Views"
             xmlns:vm="clr-namespace:D365ERAnalyzer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ConfigPaneViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <conv:BoolToGridLengthConverter x:Key="BoolToLen" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="DetailLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
            <Setter Property="Margin" Value="0,2,8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Read-only but focusable, so the text can be selected and copied. -->
        <Style x:Key="DetailField" TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <!-- Each field grows to its full content; the panel as a whole is what scrolls, so a
                 tall formula no longer gets its own scrollbar and drags the labels out of line. -->
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header -->
            <RowDefinition Height="118" MinHeight="0" />  <!-- details: fixed, drag to resize -->
            <RowDefinition Height="Auto" />  <!-- details splitter -->
            <RowDefinition Height="*" />     <!-- tree sections -->
            <RowDefinition Height="Auto" />  <!-- status -->
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FileName}" Margin="8,0,0,0"
                               Foreground="{StaticResource FgMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Text="{Binding Caption}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource FgMutedBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Open…" Command="{Binding OpenCommand}" Margin="0,0,4,0"
                            ToolTip="Load a configuration into this pane" />
                    <Button Content="Close" Command="{Binding CloseCommand}" />
                </StackPanel>

                <!-- Which of the several mapping lines to render. Absent on the other panes. -->
                <DockPanel Margin="0,6,0,0"
                           Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding OptionLabel}" VerticalAlignment="Center"
                               Margin="0,0,6,0" Foreground="{StaticResource FgMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                              MaxDropDownHeight="420" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== details for the selected row ===== -->
        <Border Grid.Row="1" Background="{StaticResource InputBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DetailName, Converter={StaticResource EmptyToVis}}" />
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailField}"
                         Text="{Binding DetailName, Mode=OneWay}"
                         Visibility="{Binding DetailName, Converter={StaticResource EmptyToVis}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DetailType, Converter={StaticResource EmptyToVis}}" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailField}"
                         Text="{Binding DetailType, Mode=OneWay}"
                         Visibility="{Binding DetailType, Converter={StaticResource EmptyToVis}}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Path" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DetailPath, Converter={StaticResource EmptyToVis}}" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailField}"
                         Text="{Binding DetailPath, Mode=OneWay}"
                         Visibility="{Binding DetailPath, Converter={StaticResource EmptyToVis}}" />

                <!-- The literal typed into the component, e.g. an XML attribute's fixed text. -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Value" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DetailValue, Converter={StaticResource EmptyToVis}}" />
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailField}"
                         FontFamily="Consolas"
                         Text="{Binding DetailValue, Mode=OneWay}"
                         Visibility="{Binding DetailValue, Converter={StaticResource EmptyToVis}}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Formula" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DetailExpression, Converter={StaticResource EmptyToVis}}" />
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailField}"
                         FontFamily="Consolas" AcceptsReturn="True"
                         Text="{Binding DetailExpression, Mode=OneWay}"
                         Visibility="{Binding DetailExpression, Converter={StaticResource EmptyToVis}}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Enabled" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DetailCondition, Converter={StaticResource EmptyToVis}}" />
                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailField}"
                         FontFamily="Consolas" AcceptsReturn="True"
                         Text="{Binding DetailCondition, Mode=OneWay}"
                         Visibility="{Binding DetailCondition, Converter={StaticResource EmptyToVis}}" />
            </Grid>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="2" Style="{StaticResource RowSplitter}" />

        <!-- ===== one or two independently scrollable tree sections ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{Binding HasSecondarySection,
                                                Converter={StaticResource BoolToLen},
                                                ConverterParameter=4}" />
                <RowDefinition Height="{Binding HasSecondarySection,
                                                Converter={StaticResource BoolToLen},
                                                ConverterParameter=star}" />
            </Grid.RowDefinitions>

            <views:TreeSectionView Grid.Row="0" DataContext="{Binding PrimarySection}" />

            <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}"
                          Visibility="{Binding DataContext.HasSecondarySection,
                                               RelativeSource={RelativeSource AncestorType=UserControl},
                                               Converter={StaticResource BoolToVis}}" />

            <views:TreeSectionView Grid.Row="2" DataContext="{Binding SecondarySection}" />
        </Grid>

        <!-- ===== status ===== -->
        <Border Grid.Row="4" Background="{StaticResource HeaderPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource FgMutedBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
